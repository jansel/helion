diff --git a/utils/providers/claude_cli_provider.py b/utils/providers/claude_cli_provider.py
new file mode 100644
index 0000000..9877616
--- /dev/null
+++ b/utils/providers/claude_cli_provider.py
@@ -0,0 +1,145 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+
+"""Tool-free Claude Code CLI transport for local KernelAgent experiments."""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any
+
+from .base import BaseProvider
+from .base import LLMResponse
+
+
+class ClaudeCLIProvider(BaseProvider):
+    """Invoke Claude through the local launcher without granting agent tools."""
+
+    def _initialize_client(self) -> None:
+        self.client = shutil.which(os.environ.get("KERNELAGENT_CLAUDE_BIN", "claude"))
+
+    def get_response(
+        self, model_name: str, messages: list[dict[str, str]], **kwargs: Any
+    ) -> LLMResponse:
+        if not self.is_available():
+            raise RuntimeError("Claude CLI is not available")
+
+        prompt = "\n\n".join(
+            f"<{message['role']}>\n{message['content']}\n</{message['role']}>"
+            for message in messages
+        )
+        effort = "high"
+        command = [
+            self.client,
+            "--safe-mode",
+            "--disable-slash-commands",
+            "--tools",
+            "",
+            "--strict-mcp-config",
+            "--mcp-config",
+            '{"mcpServers":{}}',
+            "--no-session-persistence",
+            "--permission-mode",
+            "dontAsk",
+            "--model",
+            model_name,
+            "--effort",
+            effort,
+            "--max-budget-usd",
+            os.environ.get("KERNELAGENT_CLAUDE_MAX_BUDGET_USD", "5.00"),
+            "--output-format",
+            "json",
+            "--system-prompt",
+            "You are the language model inside KernelAgent. Follow the supplied prompt. You have no tools.",
+            "--print",
+        ]
+
+        env = os.environ.copy()
+        env.pop("META_CLAUDE_DANGEROUSLY_DISABLE_LINUX_SANDBOX", None)
+        env.pop("META_CLAUDE_ENABLE_WEB_TOOLS", None)
+        cwd = Path(
+            os.environ.get(
+                "KERNELAGENT_CLAUDE_CWD", "/tmp/kernelagent-study/claude-broker"
+            )
+        )
+        cwd.mkdir(parents=True, exist_ok=True)
+        timeout_s = int(os.environ.get("KERNELAGENT_CLAUDE_TIMEOUT_S", "900"))
+
+        result = subprocess.run(
+            command,
+            input=prompt,
+            text=True,
+            capture_output=True,
+            cwd=cwd,
+            env=env,
+            timeout=timeout_s,
+        )
+        if result.returncode != 0:
+            raise RuntimeError(
+                f"Claude CLI failed with exit {result.returncode}: {result.stderr[-2000:]}"
+            )
+
+        payload = json.loads(result.stdout)
+        if payload.get("is_error") or payload.get("subtype") != "success":
+            raise RuntimeError(f"Claude CLI returned an error: {payload}")
+
+        usage_by_model = payload.get("modelUsage", {})
+        canonical_models = {
+            usage.get("canonicalModel", name)
+            for name, usage in usage_by_model.items()
+        }
+        if canonical_models != {model_name}:
+            raise RuntimeError(
+                f"Requested {model_name!r}, but Claude used {sorted(canonical_models)!r}"
+            )
+        if any(usage.get("webSearchRequests", 0) for usage in usage_by_model.values()):
+            raise RuntimeError("Claude unexpectedly used web search")
+
+        audit_path = os.environ.get("KERNELAGENT_CLAUDE_AUDIT_LOG")
+        if audit_path:
+            with Path(audit_path).open("a") as audit_file:
+                audit_file.write(
+                    json.dumps(
+                        {
+                            "requested_model": model_name,
+                            "canonical_models": sorted(canonical_models),
+                            "duration_ms": payload.get("duration_ms"),
